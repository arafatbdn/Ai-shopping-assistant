PORT=5000
CLIENT_URL=https://ai-shopping-assistant-eosin.vercel.app
MONGODB_URI=mongodb://127.0.0.1:27017/ai-shopping-assistant
JWT_SECRET=replace-with-a-long-random-secret
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-3.5-flash-lite
# Gemini Live API (client-to-server with ephemeral tokens)
# Native-audio model used by the voice conversation feature.
LIVE_MODEL=gemini-2.5-flash-native-audio-preview-12-2025
# Prebuilt voice for the native-audio model (Kore, Aoede, Charon, Fenrir, Leda, Orus, Perseus, Puck, Sadachbia, Vindemiatrix, Zephyr).
LIVE_VOICE=Kore
